# PostgreSQL (Neon / Cloud SQL) Runtime & Migration Configuration
# Configure these in Google AI Studio Secrets (never commit real credentials).
# For Neon PostgreSQL:
# - SQL_HOST: pooled endpoint (e.g. ep-xxxx-pooler.<region>.aws.neon.tech)
# - SQL_DIRECT_HOST: direct unpooled endpoint for Drizzle migrations (ep-xxxx.<region>.aws.neon.tech)
SQL_HOST="MY_NEON_POOLED_HOST"
SQL_DIRECT_HOST="MY_NEON_DIRECT_HOST"
SQL_PORT="5432"
SQL_DB_NAME="MY_NEON_DB_NAME"
SQL_USER="MY_NEON_DB_USER"
SQL_PASSWORD="MY_NEON_DB_PASSWORD"
SQL_ADMIN_USER="MY_NEON_ADMIN_USER"
SQL_ADMIN_PASSWORD="MY_NEON_ADMIN_PASSWORD"
SQL_SSL="true"
SQL_POOL_MAX="10"
SQL_CONNECTION_TIMEOUT_MS="15000"
REQUIRE_POSTGRES="false"

# Optional custom AI Studio Secrets aliases for Neon PostgreSQL (used if SQL_* are unset)
NONOLAND_DB_HOST="MY_NEON_POOLED_HOST"
NONOLAND_DB_DIRECT_HOST="MY_NEON_DIRECT_HOST"
NONOLAND_DB_NAME="MY_NEON_DB_NAME"
NONOLAND_DB_USER="MY_NEON_DB_USER"
NONOLAND_DB_PASSWORD="MY_NEON_DB_PASSWORD"


# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# YOUTUBE_API_KEY: Optional server-side YouTube Data API v3 key for fetching
# uploads from the official NonoLand channel (@Future-p6l). Never expose to client.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# ADMIN_PIN: Optional server-side Admin PIN (fail-closed when unset; no default PIN).
ADMIN_PIN="MY_ADMIN_PIN"

# Payment gateway keys (optional; uses development test verification if unset).
STRIPE_SECRET_KEY="MY_STRIPE_SECRET_KEY"
PAYMOB_API_KEY="MY_PAYMOB_API_KEY"

# Server-side secret for encrypting stored child access codes & signing cookies
# Supports NONOLAND_SESSION_SECRET (preferred) and legacy SESSION_SECRET.
NONOLAND_SESSION_SECRET="MY_NONOLAND_SESSION_SECRET"

# One-time setup secret for initializing the FIRST Super Admin account.
# Set a strong random secret in your deployment / AI Studio Secrets panel,
# complete the first-time Super Admin bootstrap once, and the system permanently
# disables bootstrap afterward. Never commit real secrets here.
NONOLAND_ADMIN_SETUP_SECRET="MY_NONOLAND_ADMIN_SETUP_SECRET"

# WebAuthn Passkeys configuration (Parent accounts only)
# In production, specify comma-separated HTTPS origin(s) and matching RP ID.
WEBAUTHN_ALLOWED_ORIGINS="https://your-domain.example"
WEBAUTHN_RP_ID="your-domain.example"

# Quran Foundation Production Content API v4 (Server-side only; never expose to client)
# Uses client_secret_basic OAuth 2.0 Client Credentials flow with granular Backend/Server scopes.
QF_CLIENT_ID="MY_QF_CLIENT_ID"
QF_CLIENT_SECRET="MY_QF_CLIENT_SECRET"
# Space-separated scopes approved for this client in Quran Foundation Developer Console:
QF_OAUTH_SCOPES="content.quran.read content.audio.read"
QF_OAUTH_URL="https://oauth2.quran.foundation/oauth2/token"
QF_API_BASE_URL="https://apis.quran.foundation/content/api/v4"
